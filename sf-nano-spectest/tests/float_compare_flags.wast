;; Float compares consumed through UCOMIS flags: branches (direct and
;; through eqz), and FP selects. Every relation is checked on both sides of
;; each ordering, on equal values, signed zeros, infinities and NaN, against
;; a register and against constants (zero takes the XOR-zero path).
(module
  (func (export "f32_eq_if") (param f32 f32) (result i32)
    (if (result i32) (f32.eq (local.get 0) (local.get 1)) (then (i32.const 1)) (else (i32.const 0))))
  (func (export "f32_eq_eqz") (param f32 f32) (result i32)
    (if (result i32) (i32.eqz (f32.eq (local.get 0) (local.get 1))) (then (i32.const 0)) (else (i32.const 1))))
  (func (export "f32_eq_brif") (param f32 f32) (result i32)
    (block $out (br_if $out (f32.eq (local.get 0) (local.get 1))) (return (i32.const 0)))
    (i32.const 1))
  (func (export "f32_eq_zero") (param f32) (result i32)
    (if (result i32) (f32.eq (local.get 0) (f32.const 0)) (then (i32.const 1)) (else (i32.const 0))))
  (func (export "f32_eq_const") (param f32) (result i32)
    (if (result i32) (f32.eq (f32.const 2) (local.get 0)) (then (i32.const 1)) (else (i32.const 0))))
  (func (export "f32_eq_value") (param f32 f32) (result i32) (f32.eq (local.get 0) (local.get 1)))
  (func (export "f32_eq_sel") (param f32 f32) (result f32)
    (select (local.get 0) (local.get 1) (f32.eq (local.get 0) (local.get 1))))
  (func (export "f32_eq_sel_const") (param f32 f32) (result f32)
    (select (f32.const 7) (f32.const -9) (f32.eq (local.get 0) (local.get 1))))
  (func (export "f32_eq_sel_keep") (param f32 f32) (result f32) (local f32)
    (local.set 2 (local.get 1))
    (local.set 2 (select (local.get 0) (local.get 2) (f32.eq (local.get 0) (local.get 1))))
    (local.get 2))
  (func (export "f32_ne_if") (param f32 f32) (result i32)
    (if (result i32) (f32.ne (local.get 0) (local.get 1)) (then (i32.const 1)) (else (i32.const 0))))
  (func (export "f32_ne_eqz") (param f32 f32) (result i32)
