;; Inline float-to-integer truncation. The conversion instruction returns the
;; destination minimum for NaN and out-of-range inputs, so every boundary
;; around that minimum and around the unsigned split points is exercised
;; here, for both the trapping and the saturating forms.

(module
  (func (export "i32_f64_s") (param f64) (result i32) (i32.trunc_f64_s (local.get 0)))
  (func (export "i32_f32_s") (param f32) (result i32) (i32.trunc_f32_s (local.get 0)))
  (func (export "i64_f64_s") (param f64) (result i64) (i64.trunc_f64_s (local.get 0)))
  (func (export "i64_f32_s") (param f32) (result i64) (i64.trunc_f32_s (local.get 0)))
  (func (export "i32_f64_u") (param f64) (result i32) (i32.trunc_f64_u (local.get 0)))
  (func (export "i32_f32_u") (param f32) (result i32) (i32.trunc_f32_u (local.get 0)))
  (func (export "i64_f64_u") (param f64) (result i64) (i64.trunc_f64_u (local.get 0)))
  (func (export "i64_f32_u") (param f32) (result i64) (i64.trunc_f32_u (local.get 0)))

  (func (export "sat_i32_f64_s") (param f64) (result i32) (i32.trunc_sat_f64_s (local.get 0)))
  (func (export "sat_i32_f32_s") (param f32) (result i32) (i32.trunc_sat_f32_s (local.get 0)))
  (func (export "sat_i64_f64_s") (param f64) (result i64) (i64.trunc_sat_f64_s (local.get 0)))
  (func (export "sat_i64_f32_s") (param f32) (result i64) (i64.trunc_sat_f32_s (local.get 0)))
  (func (export "sat_i32_f64_u") (param f64) (result i32) (i32.trunc_sat_f64_u (local.get 0)))
  (func (export "sat_i32_f32_u") (param f32) (result i32) (i32.trunc_sat_f32_u (local.get 0)))
  (func (export "sat_i64_f64_u") (param f64) (result i64) (i64.trunc_sat_f64_u (local.get 0)))
  (func (export "sat_i64_f32_u") (param f32) (result i64) (i64.trunc_sat_f32_u (local.get 0)))

  ;; The source stays live after the conversion: the rebiased upper-half
  ;; path must work on a copy, never on the source register itself.
  (func (export "u64_keeps_source") (param f64) (result f64)
    (drop (i64.trunc_f64_u (local.get 0)))
    (drop (i64.trunc_sat_f64_u (local.get 0)))
    (local.get 0))
  (func (export "u64_f32_keeps_source") (param f32) (result f32)
    (drop (i64.trunc_f32_u (local.get 0)))
    (drop (i64.trunc_sat_f32_u (local.get 0)))
    (local.get 0))

  ;; Constant and computed sources take the materialized-operand path.
  (func (export "const_u64") (result i64) (i64.trunc_f64_u (f64.const 1.8446744073709550e19)))
  (func (export "const_s32") (result i32) (i32.trunc_f64_s (f64.const -2147483648.75)))
  (func (export "sum_u32") (param f64 f64) (result i32)
    (i32.trunc_f64_u (f64.add (local.get 0) (local.get 1))))
)

;; Signed i32 from f64: the whole interval (-2^31 - 1, -2^31] is valid.
(assert_return (invoke "i32_f64_s" (f64.const -2147483648.0)) (i32.const -2147483648))
(assert_return (invoke "i32_f64_s" (f64.const -2147483648.999)) (i32.const -2147483648))
(assert_return (invoke "i32_f64_s" (f64.const 2147483647.999)) (i32.const 2147483647))
(assert_return (invoke "i32_f64_s" (f64.const -0.0)) (i32.const 0))
(assert_return (invoke "i32_f64_s" (f64.const -0.999)) (i32.const 0))
(assert_trap (invoke "i32_f64_s" (f64.const -2147483649.0)) "integer overflow")
(assert_trap (invoke "i32_f64_s" (f64.const 2147483648.0)) "integer overflow")
(assert_trap (invoke "i32_f64_s" (f64.const inf)) "integer overflow")
(assert_trap (invoke "i32_f64_s" (f64.const -inf)) "integer overflow")
(assert_trap (invoke "i32_f64_s" (f64.const nan)) "invalid conversion to integer")
(assert_trap (invoke "i32_f64_s" (f64.const -nan:0x4)) "invalid conversion to integer")

;; Signed i32 from f32: only the exact minimum is valid at the low edge.
(assert_return (invoke "i32_f32_s" (f32.const -2147483648.0)) (i32.const -2147483648))
(assert_return (invoke "i32_f32_s" (f32.const -2147483520.0)) (i32.const -2147483520))
(assert_return (invoke "i32_f32_s" (f32.const 2147483520.0)) (i32.const 2147483520))
(assert_trap (invoke "i32_f32_s" (f32.const -2147483904.0)) "integer overflow")
(assert_trap (invoke "i32_f32_s" (f32.const 2147483648.0)) "integer overflow")
(assert_trap (invoke "i32_f32_s" (f32.const nan)) "invalid conversion to integer")

;; Signed i64.
(assert_return (invoke "i64_f64_s" (f64.const -9223372036854775808.0)) (i64.const -9223372036854775808))
(assert_return (invoke "i64_f64_s" (f64.const 9223372036854774784.0)) (i64.const 9223372036854774784))
(assert_return (invoke "i64_f64_s" (f64.const -9223372036854774784.0)) (i64.const -9223372036854774784))
(assert_trap (invoke "i64_f64_s" (f64.const 9223372036854775808.0)) "integer overflow")
(assert_trap (invoke "i64_f64_s" (f64.const -9223372036854777856.0)) "integer overflow")
(assert_trap (invoke "i64_f64_s" (f64.const nan)) "invalid conversion to integer")
(assert_return (invoke "i64_f32_s" (f32.const -9223372036854775808.0)) (i64.const -9223372036854775808))
(assert_return (invoke "i64_f32_s" (f32.const 9223371487098961920.0)) (i64.const 9223371487098961920))
(assert_trap (invoke "i64_f32_s" (f32.const 9223372036854775808.0)) "integer overflow")
(assert_trap (invoke "i64_f32_s" (f32.const -9223373136366403584.0)) "integer overflow")
(assert_trap (invoke "i64_f32_s" (f32.const -nan)) "invalid conversion to integer")

;; Unsigned i32: (-1, 2^32) is valid.
(assert_return (invoke "i32_f64_u" (f64.const -0.999)) (i32.const 0))
(assert_return (invoke "i32_f64_u" (f64.const 4294967295.999)) (i32.const -1))
(assert_return (invoke "i32_f64_u" (f64.const 2147483648.0)) (i32.const -2147483648))
(assert_trap (invoke "i32_f64_u" (f64.const -1.0)) "integer overflow")
(assert_trap (invoke "i32_f64_u" (f64.const 4294967296.0)) "integer overflow")
(assert_trap (invoke "i32_f64_u" (f64.const 1e19)) "integer overflow")
(assert_trap (invoke "i32_f64_u" (f64.const -1e19)) "integer overflow")
(assert_trap (invoke "i32_f64_u" (f64.const nan)) "invalid conversion to integer")
(assert_return (invoke "i32_f32_u" (f32.const 4294967040.0)) (i32.const -256))
(assert_trap (invoke "i32_f32_u" (f32.const 4294967296.0)) "integer overflow")
(assert_trap (invoke "i32_f32_u" (f32.const inf)) "integer overflow")
(assert_trap (invoke "i32_f32_u" (f32.const nan)) "invalid conversion to integer")

;; Unsigned i64: both halves of the 2^63 split.
(assert_return (invoke "i64_f64_u" (f64.const -0.999)) (i64.const 0))
(assert_return (invoke "i64_f64_u" (f64.const 9223372036854774784.0)) (i64.const 9223372036854774784))
(assert_return (invoke "i64_f64_u" (f64.const 9223372036854775808.0)) (i64.const -9223372036854775808))
(assert_return (invoke "i64_f64_u" (f64.const 18446744073709549568.0)) (i64.const -2048))
(assert_trap (invoke "i64_f64_u" (f64.const 18446744073709551616.0)) "integer overflow")
(assert_trap (invoke "i64_f64_u" (f64.const -1.0)) "integer overflow")
(assert_trap (invoke "i64_f64_u" (f64.const inf)) "integer overflow")
(assert_trap (invoke "i64_f64_u" (f64.const nan)) "invalid conversion to integer")
(assert_return (invoke "i64_f32_u" (f32.const 9223372036854775808.0)) (i64.const -9223372036854775808))
(assert_return (invoke "i64_f32_u" (f32.const 18446742974197923840.0)) (i64.const -1099511627776))
(assert_trap (invoke "i64_f32_u" (f32.const 18446744073709551616.0)) "integer overflow")
(assert_trap (invoke "i64_f32_u" (f32.const -1.0)) "integer overflow")
(assert_trap (invoke "i64_f32_u" (f32.const nan)) "invalid conversion to integer")

;; Saturating forms clamp and send NaN to zero.
(assert_return (invoke "sat_i32_f64_s" (f64.const -2147483648.999)) (i32.const -2147483648))
(assert_return (invoke "sat_i32_f64_s" (f64.const -1e300)) (i32.const -2147483648))
(assert_return (invoke "sat_i32_f64_s" (f64.const 2147483648.0)) (i32.const 2147483647))
(assert_return (invoke "sat_i32_f64_s" (f64.const inf)) (i32.const 2147483647))
(assert_return (invoke "sat_i32_f64_s" (f64.const nan)) (i32.const 0))
(assert_return (invoke "sat_i32_f64_s" (f64.const 12.9)) (i32.const 12))
(assert_return (invoke "sat_i32_f32_s" (f32.const -inf)) (i32.const -2147483648))
(assert_return (invoke "sat_i32_f32_s" (f32.const 3e9)) (i32.const 2147483647))
(assert_return (invoke "sat_i32_f32_s" (f32.const -nan)) (i32.const 0))
(assert_return (invoke "sat_i64_f64_s" (f64.const 1e19)) (i64.const 9223372036854775807))
(assert_return (invoke "sat_i64_f64_s" (f64.const -1e19)) (i64.const -9223372036854775808))
(assert_return (invoke "sat_i64_f64_s" (f64.const -9223372036854775808.0)) (i64.const -9223372036854775808))
(assert_return (invoke "sat_i64_f64_s" (f64.const nan)) (i64.const 0))
(assert_return (invoke "sat_i64_f32_s" (f32.const inf)) (i64.const 9223372036854775807))
(assert_return (invoke "sat_i64_f32_s" (f32.const nan)) (i64.const 0))
(assert_return (invoke "sat_i32_f64_u" (f64.const -0.999)) (i32.const 0))
(assert_return (invoke "sat_i32_f64_u" (f64.const -5.0)) (i32.const 0))
(assert_return (invoke "sat_i32_f64_u" (f64.const 4294967296.0)) (i32.const -1))
(assert_return (invoke "sat_i32_f64_u" (f64.const 1e300)) (i32.const -1))
(assert_return (invoke "sat_i32_f64_u" (f64.const 4294967295.5)) (i32.const -1))
(assert_return (invoke "sat_i32_f64_u" (f64.const 3000000000.5)) (i32.const -1294967296))
(assert_return (invoke "sat_i32_f64_u" (f64.const nan)) (i32.const 0))
(assert_return (invoke "sat_i32_f32_u" (f32.const -inf)) (i32.const 0))
(assert_return (invoke "sat_i32_f32_u" (f32.const inf)) (i32.const -1))
(assert_return (invoke "sat_i32_f32_u" (f32.const nan)) (i32.const 0))
(assert_return (invoke "sat_i64_f64_u" (f64.const -1.0)) (i64.const 0))
(assert_return (invoke "sat_i64_f64_u" (f64.const 9223372036854775808.0)) (i64.const -9223372036854775808))
(assert_return (invoke "sat_i64_f64_u" (f64.const 18446744073709549568.0)) (i64.const -2048))
(assert_return (invoke "sat_i64_f64_u" (f64.const 18446744073709551616.0)) (i64.const -1))
(assert_return (invoke "sat_i64_f64_u" (f64.const inf)) (i64.const -1))
(assert_return (invoke "sat_i64_f64_u" (f64.const nan)) (i64.const 0))
(assert_return (invoke "sat_i64_f32_u" (f32.const 18446742974197923840.0)) (i64.const -1099511627776))
(assert_return (invoke "sat_i64_f32_u" (f32.const 18446744073709551616.0)) (i64.const -1))
(assert_return (invoke "sat_i64_f32_u" (f32.const -inf)) (i64.const 0))
(assert_return (invoke "sat_i64_f32_u" (f32.const nan)) (i64.const 0))

(assert_return (invoke "u64_keeps_source" (f64.const 1.5e19)) (f64.const 1.5e19))
(assert_return (invoke "u64_keeps_source" (f64.const 12.5)) (f64.const 12.5))
(assert_return (invoke "u64_f32_keeps_source" (f32.const 1.5e19)) (f32.const 1.5e19))
(assert_return (invoke "const_u64") (i64.const -2048))
(assert_return (invoke "const_s32") (i32.const -2147483648))
(assert_return (invoke "sum_u32" (f64.const 4294967000.25) (f64.const 295.5)) (i32.const -1))
