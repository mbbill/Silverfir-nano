  (func (export "i64_add_le_u") (param i64 i64 i64) (result i64) (i64.add (local.get 0) (i64.extend_i32_u (i64.le_u (local.get 1) (local.get 2)))))
  (func (export "i64_sub_le_u") (param i64 i64 i64) (result i64) (i64.sub (local.get 0) (i64.extend_i32_u (i64.le_u (local.get 1) (local.get 2)))))
  (func (export "i32_immr_le_u") (param i32 i32) (result i32) (i32.add (local.get 0) (i32.le_u (local.get 1) (i32.const 1000))))
  (func (export "i32_imml_le_u") (param i32 i32) (result i32) (i32.add (local.get 0) (i32.le_u (i32.const 1000) (local.get 1))))
  (func (export "i32_alias_le_u") (param i32 i32) (result i32) (local.set 0 (i32.add (local.get 0) (i32.le_u (local.get 0) (local.get 1)))) (local.get 0))
  (func (export "i32_eqz_le_u") (param i32 i32 i32) (result i32) (if (result i32) (i32.eqz (i32.add (local.get 0) (i32.le_u (local.get 1) (local.get 2)))) (then (i32.const 111)) (else (i32.const 222))))
  (func (export "i32_add_ge_u") (param i32 i32 i32) (result i32) (i32.add (local.get 0) (i32.ge_u (local.get 1) (local.get 2))))
  (func (export "i32_rev_ge_u") (param i32 i32 i32) (result i32) (i32.add (i32.ge_u (local.get 1) (local.get 2)) (local.get 0)))
  (func (export "i32_sub_ge_u") (param i32 i32 i32) (result i32) (i32.sub (local.get 0) (i32.ge_u (local.get 1) (local.get 2))))
  (func (export "i32_wide_ge_u") (param i32 i64 i64) (result i32) (i32.add (local.get 0) (i64.ge_u (local.get 1) (local.get 2))))
  (func (export "i64_add_ge_u") (param i64 i64 i64) (result i64) (i64.add (local.get 0) (i64.extend_i32_u (i64.ge_u (local.get 1) (local.get 2)))))
  (func (export "i64_sub_ge_u") (param i64 i64 i64) (result i64) (i64.sub (local.get 0) (i64.extend_i32_u (i64.ge_u (local.get 1) (local.get 2)))))
  (func (export "i32_immr_ge_u") (param i32 i32) (result i32) (i32.add (local.get 0) (i32.ge_u (local.get 1) (i32.const 1000))))
  (func (export "i32_imml_ge_u") (param i32 i32) (result i32) (i32.add (local.get 0) (i32.ge_u (i32.const 1000) (local.get 1))))
  (func (export "i32_alias_ge_u") (param i32 i32) (result i32) (local.set 0 (i32.add (local.get 0) (i32.ge_u (local.get 0) (local.get 1)))) (local.get 0))
  (func (export "i32_eqz_ge_u") (param i32 i32 i32) (result i32) (if (result i32) (i32.eqz (i32.add (local.get 0) (i32.ge_u (local.get 1) (local.get 2)))) (then (i32.const 111)) (else (i32.const 222))))
  (func (export "count_below") (param $n i32) (param $t i32) (result i32)
    (local $i i32) (local $c i32)
    (block $done
      (loop $next
        (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
        (local.set $c (i32.add (local.get $c)
          (i32.lt_u (i32.shr_u (i32.mul (local.get $i) (i32.const 0x9E3779B1)) (i32.const 16)) (local.get $t))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $next)))
    (local.get $c))
)
