;; Unsigned ordering compares whose 0/1 result is added to or subtracted
;; from another value fuse into CMP + ADC/SBB on x86-64 (CF holds the
;; predicate or its negation). Covers every unsigned predicate in both
;; widths, an i64 compare feeding an i32 add, an i64 accumulator through a
;; zero-extend, both add operand orders, subtraction, immediate operands,
;; an accumulator that is also a compare operand, a zero test consuming
;; the ADC/SBB flags, and a counting loop.
(module
  (func (export "i32_add_lt_u") (param i32 i32 i32) (result i32) (i32.add (local.get 0) (i32.lt_u (local.get 1) (local.get 2))))
  (func (export "i32_rev_lt_u") (param i32 i32 i32) (result i32) (i32.add (i32.lt_u (local.get 1) (local.get 2)) (local.get 0)))
  (func (export "i32_sub_lt_u") (param i32 i32 i32) (result i32) (i32.sub (local.get 0) (i32.lt_u (local.get 1) (local.get 2))))
  (func (export "i32_wide_lt_u") (param i32 i64 i64) (result i32) (i32.add (local.get 0) (i64.lt_u (local.get 1) (local.get 2))))
  (func (export "i64_add_lt_u") (param i64 i64 i64) (result i64) (i64.add (local.get 0) (i64.extend_i32_u (i64.lt_u (local.get 1) (local.get 2)))))
  (func (export "i64_sub_lt_u") (param i64 i64 i64) (result i64) (i64.sub (local.get 0) (i64.extend_i32_u (i64.lt_u (local.get 1) (local.get 2)))))
  (func (export "i32_immr_lt_u") (param i32 i32) (result i32) (i32.add (local.get 0) (i32.lt_u (local.get 1) (i32.const 1000))))
  (func (export "i32_imml_lt_u") (param i32 i32) (result i32) (i32.add (local.get 0) (i32.lt_u (i32.const 1000) (local.get 1))))
  (func (export "i32_alias_lt_u") (param i32 i32) (result i32) (local.set 0 (i32.add (local.get 0) (i32.lt_u (local.get 0) (local.get 1)))) (local.get 0))
  (func (export "i32_eqz_lt_u") (param i32 i32 i32) (result i32) (if (result i32) (i32.eqz (i32.add (local.get 0) (i32.lt_u (local.get 1) (local.get 2)))) (then (i32.const 111)) (else (i32.const 222))))
  (func (export "i32_add_gt_u") (param i32 i32 i32) (result i32) (i32.add (local.get 0) (i32.gt_u (local.get 1) (local.get 2))))
  (func (export "i32_rev_gt_u") (param i32 i32 i32) (result i32) (i32.add (i32.gt_u (local.get 1) (local.get 2)) (local.get 0)))
  (func (export "i32_sub_gt_u") (param i32 i32 i32) (result i32) (i32.sub (local.get 0) (i32.gt_u (local.get 1) (local.get 2))))
  (func (export "i32_wide_gt_u") (param i32 i64 i64) (result i32) (i32.add (local.get 0) (i64.gt_u (local.get 1) (local.get 2))))
  (func (export "i64_add_gt_u") (param i64 i64 i64) (result i64) (i64.add (local.get 0) (i64.extend_i32_u (i64.gt_u (local.get 1) (local.get 2)))))
  (func (export "i64_sub_gt_u") (param i64 i64 i64) (result i64) (i64.sub (local.get 0) (i64.extend_i32_u (i64.gt_u (local.get 1) (local.get 2)))))
  (func (export "i32_immr_gt_u") (param i32 i32) (result i32) (i32.add (local.get 0) (i32.gt_u (local.get 1) (i32.const 1000))))
  (func (export "i32_imml_gt_u") (param i32 i32) (result i32) (i32.add (local.get 0) (i32.gt_u (i32.const 1000) (local.get 1))))
  (func (export "i32_alias_gt_u") (param i32 i32) (result i32) (local.set 0 (i32.add (local.get 0) (i32.gt_u (local.get 0) (local.get 1)))) (local.get 0))
  (func (export "i32_eqz_gt_u") (param i32 i32 i32) (result i32) (if (result i32) (i32.eqz (i32.add (local.get 0) (i32.gt_u (local.get 1) (local.get 2)))) (then (i32.const 111)) (else (i32.const 222))))
  (func (export "i32_add_le_u") (param i32 i32 i32) (result i32) (i32.add (local.get 0) (i32.le_u (local.get 1) (local.get 2))))
  (func (export "i32_rev_le_u") (param i32 i32 i32) (result i32) (i32.add (i32.le_u (local.get 1) (local.get 2)) (local.get 0)))
  (func (export "i32_sub_le_u") (param i32 i32 i32) (result i32) (i32.sub (local.get 0) (i32.le_u (local.get 1) (local.get 2))))
