;; Read-modify-write updates of one memory word: load, one ALU op, and a
;; store back to the same address fuse into a single instruction when the
;; intermediate values are dead. Covers every fusible op in both widths,
;; immediates and registers, both operand orders, offsets, a loaded value
;; that stays live (no fusion), and an out-of-bounds update that must trap
;; before writing anything.
(module
  (memory 1)
  (func (export "i32_add_imm") (param i32)
    (i32.store offset=8 (local.get 0) (i32.add (i32.load offset=8 (local.get 0)) (i32.const -77))))
  (func (export "i32_add_reg") (param i32 i32)
    (i32.store (local.get 0) (i32.add (i32.load (local.get 0)) (local.get 1))))
  (func (export "i32_add_rev") (param i32 i32)
    (i32.store offset=16 (local.get 0) (i32.add (local.get 1) (i32.load offset=16 (local.get 0)))))
  (func (export "i32_sub_imm") (param i32)
    (i32.store offset=8 (local.get 0) (i32.sub (i32.load offset=8 (local.get 0)) (i32.const -77))))
  (func (export "i32_sub_reg") (param i32 i32)
    (i32.store (local.get 0) (i32.sub (i32.load (local.get 0)) (local.get 1))))
  (func (export "i32_and_imm") (param i32)
    (i32.store offset=8 (local.get 0) (i32.and (i32.load offset=8 (local.get 0)) (i32.const -77))))
  (func (export "i32_and_reg") (param i32 i32)
    (i32.store (local.get 0) (i32.and (i32.load (local.get 0)) (local.get 1))))
  (func (export "i32_and_rev") (param i32 i32)
    (i32.store offset=16 (local.get 0) (i32.and (local.get 1) (i32.load offset=16 (local.get 0)))))
  (func (export "i32_or_imm") (param i32)
    (i32.store offset=8 (local.get 0) (i32.or (i32.load offset=8 (local.get 0)) (i32.const -77))))
  (func (export "i32_or_reg") (param i32 i32)
    (i32.store (local.get 0) (i32.or (i32.load (local.get 0)) (local.get 1))))
  (func (export "i32_or_rev") (param i32 i32)
    (i32.store offset=16 (local.get 0) (i32.or (local.get 1) (i32.load offset=16 (local.get 0)))))
  (func (export "i32_xor_imm") (param i32)
    (i32.store offset=8 (local.get 0) (i32.xor (i32.load offset=8 (local.get 0)) (i32.const -77))))
  (func (export "i32_xor_reg") (param i32 i32)
    (i32.store (local.get 0) (i32.xor (i32.load (local.get 0)) (local.get 1))))
  (func (export "i32_xor_rev") (param i32 i32)
    (i32.store offset=16 (local.get 0) (i32.xor (local.get 1) (i32.load offset=16 (local.get 0)))))
  (func (export "i32_rsub") (param i32 i32)
    (i32.store (local.get 0) (i32.sub (local.get 1) (i32.load (local.get 0)))))
  (func (export "i32_live") (param i32 i32) (result i32) (local i32)
    (i32.store (local.get 0) (i32.add (local.tee 2 (i32.load (local.get 0))) (local.get 1)))
    (local.get 2))
  (func (export "i32_get") (param i32) (result i32) (i32.load (local.get 0)))
  (func (export "i32_set") (param i32 i32) (i32.store (local.get 0) (local.get 1)))
  (func (export "i64_add_imm") (param i32)
    (i64.store offset=8 (local.get 0) (i64.add (i64.load offset=8 (local.get 0)) (i64.const -77))))
  (func (export "i64_add_reg") (param i32 i64)
    (i64.store (local.get 0) (i64.add (i64.load (local.get 0)) (local.get 1))))
  (func (export "i64_add_rev") (param i32 i64)
    (i64.store offset=16 (local.get 0) (i64.add (local.get 1) (i64.load offset=16 (local.get 0)))))
  (func (export "i64_sub_imm") (param i32)
    (i64.store offset=8 (local.get 0) (i64.sub (i64.load offset=8 (local.get 0)) (i64.const -77))))
  (func (export "i64_sub_reg") (param i32 i64)
    (i64.store (local.get 0) (i64.sub (i64.load (local.get 0)) (local.get 1))))
  (func (export "i64_and_imm") (param i32)
    (i64.store offset=8 (local.get 0) (i64.and (i64.load offset=8 (local.get 0)) (i64.const -77))))
  (func (export "i64_and_reg") (param i32 i64)
    (i64.store (local.get 0) (i64.and (i64.load (local.get 0)) (local.get 1))))
  (func (export "i64_and_rev") (param i32 i64)
    (i64.store offset=16 (local.get 0) (i64.and (local.get 1) (i64.load offset=16 (local.get 0)))))
  (func (export "i64_or_imm") (param i32)
    (i64.store offset=8 (local.get 0) (i64.or (i64.load offset=8 (local.get 0)) (i64.const -77))))
  (func (export "i64_or_reg") (param i32 i64)
    (i64.store (local.get 0) (i64.or (i64.load (local.get 0)) (local.get 1))))
  (func (export "i64_or_rev") (param i32 i64)
    (i64.store offset=16 (local.get 0) (i64.or (local.get 1) (i64.load offset=16 (local.get 0)))))
  (func (export "i64_xor_imm") (param i32)
    (i64.store offset=8 (local.get 0) (i64.xor (i64.load offset=8 (local.get 0)) (i64.const -77))))
  (func (export "i64_xor_reg") (param i32 i64)
    (i64.store (local.get 0) (i64.xor (i64.load (local.get 0)) (local.get 1))))
  (func (export "i64_xor_rev") (param i32 i64)
    (i64.store offset=16 (local.get 0) (i64.xor (local.get 1) (i64.load offset=16 (local.get 0)))))
  (func (export "i64_rsub") (param i32 i64)
    (i64.store (local.get 0) (i64.sub (local.get 1) (i64.load (local.get 0)))))
  (func (export "i64_live") (param i32 i64) (result i64) (local i64)
    (i64.store (local.get 0) (i64.add (local.tee 2 (i64.load (local.get 0))) (local.get 1)))
    (local.get 2))
  (func (export "i64_get") (param i32) (result i64) (i64.load (local.get 0)))
  (func (export "i64_set") (param i32 i64) (i64.store (local.get 0) (local.get 1)))
  ;; A large i64 immediate does not fit imm32 and stays unfused.
  (func (export "i64_add_big") (param i32)
    (i64.store (local.get 0) (i64.add (i64.load (local.get 0)) (i64.const 0x123456789))))
  ;; A loop of updates, as in bzip2's bucket marking.
  (func (export "mark") (param i32 i32)
    (loop $l
      (i32.store (local.get 0) (i32.or (i32.load (local.get 0)) (i32.const 0x200000)))
      (local.set 0 (i32.add (local.get 0) (i32.const 4)))
      (br_if $l (local.tee 1 (i32.sub (local.get 1) (i32.const 1))))))
)
(invoke "i32_set" (i32.const 104) (i32.const -1985229329))
(invoke "i32_add_imm" (i32.const 96))
(assert_return (invoke "i32_get" (i32.const 104)) (i32.const -1985229406))
(invoke "i32_set" (i32.const 200) (i32.const -1985229329))
(invoke "i32_add_reg" (i32.const 200) (i32.const 305419896))
(assert_return (invoke "i32_get" (i32.const 200)) (i32.const -1679809433))
(invoke "i32_set" (i32.const 316) (i32.const -1985229329))
(invoke "i32_add_rev" (i32.const 300) (i32.const 305419896))
(assert_return (invoke "i32_get" (i32.const 316)) (i32.const -1679809433))
(invoke "i32_set" (i32.const 104) (i32.const -1985229329))
(invoke "i32_sub_imm" (i32.const 96))
(assert_return (invoke "i32_get" (i32.const 104)) (i32.const -1985229252))
(invoke "i32_set" (i32.const 200) (i32.const -1985229329))
(invoke "i32_sub_reg" (i32.const 200) (i32.const 305419896))
(assert_return (invoke "i32_get" (i32.const 200)) (i32.const 2004318071))
(invoke "i32_set" (i32.const 104) (i32.const -1985229329))
(invoke "i32_and_imm" (i32.const 96))
(assert_return (invoke "i32_get" (i32.const 104)) (i32.const -1985229405))
(invoke "i32_set" (i32.const 200) (i32.const -1985229329))
(invoke "i32_and_reg" (i32.const 200) (i32.const 305419896))
(assert_return (invoke "i32_get" (i32.const 200)) (i32.const 2114664))
(invoke "i32_set" (i32.const 316) (i32.const -1985229329))
(invoke "i32_and_rev" (i32.const 300) (i32.const 305419896))
(assert_return (invoke "i32_get" (i32.const 316)) (i32.const 2114664))
(invoke "i32_set" (i32.const 104) (i32.const -1985229329))
(invoke "i32_or_imm" (i32.const 96))
(assert_return (invoke "i32_get" (i32.const 104)) (i32.const -1))
(invoke "i32_set" (i32.const 200) (i32.const -1985229329))
(invoke "i32_or_reg" (i32.const 200) (i32.const 305419896))
(assert_return (invoke "i32_get" (i32.const 200)) (i32.const -1681924097))
(invoke "i32_set" (i32.const 316) (i32.const -1985229329))
(invoke "i32_or_rev" (i32.const 300) (i32.const 305419896))
(assert_return (invoke "i32_get" (i32.const 316)) (i32.const -1681924097))
(invoke "i32_set" (i32.const 104) (i32.const -1985229329))
(invoke "i32_xor_imm" (i32.const 96))
(assert_return (invoke "i32_get" (i32.const 104)) (i32.const 1985229404))
(invoke "i32_set" (i32.const 200) (i32.const -1985229329))
(invoke "i32_xor_reg" (i32.const 200) (i32.const 305419896))
(assert_return (invoke "i32_get" (i32.const 200)) (i32.const -1684038761))
(invoke "i32_set" (i32.const 316) (i32.const -1985229329))
(invoke "i32_xor_rev" (i32.const 300) (i32.const 305419896))
(assert_return (invoke "i32_get" (i32.const 316)) (i32.const -1684038761))
(invoke "i32_set" (i32.const 400) (i32.const -1985229329))
(invoke "i32_rsub" (i32.const 400) (i32.const 305419896))
(assert_return (invoke "i32_get" (i32.const 400)) (i32.const -2004318071))
(invoke "i32_set" (i32.const 500) (i32.const -1985229329))
(assert_return (invoke "i32_live" (i32.const 500) (i32.const 5)) (i32.const -1985229329))
(assert_return (invoke "i32_get" (i32.const 500)) (i32.const -1985229324))
(invoke "i32_set" (i32.const 65532) (i32.const -1985229329))
(invoke "i32_or_reg" (i32.const 65532) (i32.const 1))
(assert_return (invoke "i32_get" (i32.const 65532)) (i32.const -1985229329))
(assert_trap (invoke "i32_or_reg" (i32.const 65533) (i32.const -1)) "out of bounds memory access")
(assert_return (invoke "i32_get" (i32.const 65532)) (i32.const -1985229329))
(assert_trap (invoke "i32_add_imm" (i32.const -8)) "out of bounds memory access")
(invoke "i64_set" (i32.const 104) (i64.const 81985529216486895))
(invoke "i64_add_imm" (i32.const 96))
(assert_return (invoke "i64_get" (i32.const 104)) (i64.const 81985529216486818))
(invoke "i64_set" (i32.const 200) (i64.const 81985529216486895))
(invoke "i64_add_reg" (i32.const 200) (i64.const 9141386507638288912))
(assert_return (invoke "i64_get" (i32.const 200)) (i64.const 9223372036854775807))
(invoke "i64_set" (i32.const 316) (i64.const 81985529216486895))
(invoke "i64_add_rev" (i32.const 300) (i64.const 9141386507638288912))
(assert_return (invoke "i64_get" (i32.const 316)) (i64.const 9223372036854775807))
(invoke "i64_set" (i32.const 104) (i64.const 81985529216486895))
(invoke "i64_sub_imm" (i32.const 96))
(assert_return (invoke "i64_get" (i32.const 104)) (i64.const 81985529216486972))
(invoke "i64_set" (i32.const 200) (i64.const 81985529216486895))
(invoke "i64_sub_reg" (i32.const 200) (i64.const 9141386507638288912))
(assert_return (invoke "i64_get" (i32.const 200)) (i64.const -9059400978421802017))
(invoke "i64_set" (i32.const 104) (i64.const 81985529216486895))
(invoke "i64_and_imm" (i32.const 96))
(assert_return (invoke "i64_get" (i32.const 104)) (i64.const 81985529216486819))
(invoke "i64_set" (i32.const 200) (i64.const 81985529216486895))
(invoke "i64_and_reg" (i32.const 200) (i64.const 9141386507638288912))
(assert_return (invoke "i64_get" (i32.const 200)) (i64.const 0))
(invoke "i64_set" (i32.const 316) (i64.const 81985529216486895))
(invoke "i64_and_rev" (i32.const 300) (i64.const 9141386507638288912))
(assert_return (invoke "i64_get" (i32.const 316)) (i64.const 0))
(invoke "i64_set" (i32.const 104) (i64.const 81985529216486895))
(invoke "i64_or_imm" (i32.const 96))
(assert_return (invoke "i64_get" (i32.const 104)) (i64.const -1))
(invoke "i64_set" (i32.const 200) (i64.const 81985529216486895))
(invoke "i64_or_reg" (i32.const 200) (i64.const 9141386507638288912))
(assert_return (invoke "i64_get" (i32.const 200)) (i64.const 9223372036854775807))
(invoke "i64_set" (i32.const 316) (i64.const 81985529216486895))
(invoke "i64_or_rev" (i32.const 300) (i64.const 9141386507638288912))
(assert_return (invoke "i64_get" (i32.const 316)) (i64.const 9223372036854775807))
(invoke "i64_set" (i32.const 104) (i64.const 81985529216486895))
(invoke "i64_xor_imm" (i32.const 96))
(assert_return (invoke "i64_get" (i32.const 104)) (i64.const -81985529216486820))
(invoke "i64_set" (i32.const 200) (i64.const 81985529216486895))
(invoke "i64_xor_reg" (i32.const 200) (i64.const 9141386507638288912))
(assert_return (invoke "i64_get" (i32.const 200)) (i64.const 9223372036854775807))
(invoke "i64_set" (i32.const 316) (i64.const 81985529216486895))
(invoke "i64_xor_rev" (i32.const 300) (i64.const 9141386507638288912))
(assert_return (invoke "i64_get" (i32.const 316)) (i64.const 9223372036854775807))
(invoke "i64_set" (i32.const 400) (i64.const 81985529216486895))
(invoke "i64_rsub" (i32.const 400) (i64.const 9141386507638288912))
(assert_return (invoke "i64_get" (i32.const 400)) (i64.const 9059400978421802017))
(invoke "i64_set" (i32.const 500) (i64.const 81985529216486895))
(assert_return (invoke "i64_live" (i32.const 500) (i64.const 5)) (i64.const 81985529216486895))
(assert_return (invoke "i64_get" (i32.const 500)) (i64.const 81985529216486900))
(invoke "i64_set" (i32.const 65528) (i64.const 81985529216486895))
(invoke "i64_or_reg" (i32.const 65528) (i64.const 1))
(assert_return (invoke "i64_get" (i32.const 65528)) (i64.const 81985529216486895))
(assert_trap (invoke "i64_or_reg" (i32.const 65529) (i64.const -1)) "out of bounds memory access")
(assert_return (invoke "i64_get" (i32.const 65528)) (i64.const 81985529216486895))
(assert_trap (invoke "i64_add_imm" (i32.const -8)) "out of bounds memory access")
(invoke "i64_set" (i32.const 600) (i64.const 5))
(invoke "i64_add_big" (i32.const 600))
(assert_return (invoke "i64_get" (i32.const 600)) (i64.const 4886718350))
(invoke "i32_set" (i32.const 1000) (i32.const 1))
(invoke "i32_set" (i32.const 1004) (i32.const 2))
(invoke "i32_set" (i32.const 1008) (i32.const 3))
(invoke "mark" (i32.const 1000) (i32.const 3))
(assert_return (invoke "i32_get" (i32.const 1000)) (i32.const 0x200001))
(assert_return (invoke "i32_get" (i32.const 1004)) (i32.const 0x200002))
(assert_return (invoke "i32_get" (i32.const 1008)) (i32.const 0x200003))
(assert_return (invoke "i32_get" (i32.const 1012)) (i32.const 0))
