;; Native interpreter handlers for div/rem and float-to-int truncation exit
;; to a shared slow executor on their trap edges, and that executor reads
;; every operand from its frame slot. An operand produced straight into the
;; accumulator never reaches its slot, so these handlers must not consume
;; the accumulator. `poison` leaves non-trapping garbage in the stack slots
;; the later frames reuse, so a stale slot read cannot pass by accident.
(module
  (func (export "poison") (param i64 i64) (local i64 i64 i64 i64)
    (local.set 2 (i64.const 0x40c81c8000000777))
    (local.set 3 (i64.const 0x40c81c8000000777))
    (local.set 4 (i64.const 0x40c81c8000000777))
    (local.set 5 (i64.const 0x40c81c8000000777)))
  ;; Divisor computed immediately before the division.
  (func (export "div_u") (param i32 i32) (result i32)
    (i32.div_u (local.get 0) (i32.add (local.get 1) (local.get 1))))
  (func (export "div_s") (param i32 i32) (result i32)
    (i32.div_s (local.get 0) (i32.add (local.get 1) (local.get 1))))
  (func (export "rem_u") (param i32 i32) (result i32)
    (i32.rem_u (local.get 0) (i32.add (local.get 1) (local.get 1))))
  (func (export "rem_s") (param i32 i32) (result i32)
    (i32.rem_s (local.get 0) (i32.add (local.get 1) (local.get 1))))
  (func (export "div_u64") (param i64 i64) (result i64)
    (i64.div_u (local.get 0) (i64.add (local.get 1) (local.get 1))))
  (func (export "rem_s64") (param i64 i64) (result i64)
    (i64.rem_s (local.get 0) (i64.add (local.get 1) (local.get 1))))
  ;; Dividend computed immediately before the division: MIN / -1.
  (func (export "div_s_min") (param i32 i32) (result i32)
    (i32.div_s (i32.sub (local.get 0) (i32.const 1)) (local.get 1)))
  ;; Truncated value computed immediately before the conversion.
  (func (export "trunc_u32") (param f64 f64) (result i32)
    (i32.trunc_f64_u (f64.add (local.get 0) (local.get 1))))
  (func (export "trunc_s32") (param f64 f64) (result i32)
    (i32.trunc_f64_s (f64.add (local.get 0) (local.get 1))))
  (func (export "trunc_s64_f32") (param f32 f32) (result i64)
    (i64.trunc_f32_s (f32.mul (local.get 0) (local.get 1))))
  (func (export "trunc_nan") (param f64) (result i32)
    (i32.trunc_f64_s (f64.sub (local.get 0) (local.get 0))))
)
(invoke "poison" (i64.const 0) (i64.const 0))
(assert_trap (invoke "div_u" (i32.const 10) (i32.const 0)) "integer divide by zero")
(invoke "poison" (i64.const 0) (i64.const 0))
(assert_trap (invoke "div_s" (i32.const 10) (i32.const 0)) "integer divide by zero")
(invoke "poison" (i64.const 0) (i64.const 0))
(assert_trap (invoke "rem_u" (i32.const 10) (i32.const 0)) "integer divide by zero")
(invoke "poison" (i64.const 0) (i64.const 0))
(assert_trap (invoke "rem_s" (i32.const 10) (i32.const 0)) "integer divide by zero")
(invoke "poison" (i64.const 0) (i64.const 0))
(assert_trap (invoke "div_u64" (i64.const 10) (i64.const 0)) "integer divide by zero")
(invoke "poison" (i64.const 0) (i64.const 0))
(assert_trap (invoke "rem_s64" (i64.const 10) (i64.const 0)) "integer divide by zero")
(invoke "poison" (i64.const 0) (i64.const 0))
(assert_trap (invoke "div_s_min" (i32.const 0x80000001) (i32.const -1)) "integer overflow")
(invoke "poison" (i64.const 0) (i64.const 0))
(assert_trap (invoke "trunc_u32" (f64.const 4294967000.25) (f64.const 296.0)) "integer overflow")
(invoke "poison" (i64.const 0) (i64.const 0))
(assert_trap (invoke "trunc_s32" (f64.const 2147483000.0) (f64.const 1000.0)) "integer overflow")
(invoke "poison" (i64.const 0) (i64.const 0))
(assert_trap (invoke "trunc_s64_f32" (f32.const 1e10) (f32.const 1e10)) "integer overflow")
(invoke "poison" (i64.const 0) (i64.const 0))
(assert_trap (invoke "trunc_nan" (f64.const inf)) "invalid conversion to integer")
;; The non-trapping edges keep working.
(assert_return (invoke "div_u" (i32.const 10) (i32.const 1)) (i32.const 5))
(assert_return (invoke "rem_s" (i32.const -7) (i32.const 2)) (i32.const -3))
(assert_return (invoke "trunc_u32" (f64.const 4294967000.25) (f64.const 295.5)) (i32.const -1))
(assert_return (invoke "trunc_s64_f32" (f32.const 1e5) (f32.const 1e5)) (i64.const 10000000000))
