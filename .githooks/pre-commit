#!/usr/bin/env bash

set -euo pipefail

if ! command -v rustfmt >/dev/null 2>&1; then
    echo "rustfmt is required for this pre-commit hook." >&2
    echo "Install it with: rustup component add rustfmt" >&2
    exit 1
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

staged_rust_files=()
while IFS= read -r file; do
    staged_rust_files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.rs')

if [[ ${#staged_rust_files[@]} -eq 0 ]]; then
    exit 0
fi

find_manifest_dir() {
    local file="$1"
    local dir

    dir="$(dirname "$file")"
    while [[ "$dir" != "." && "$dir" != "/" ]]; do
        if [[ -f "$dir/Cargo.toml" ]]; then
            printf '%s\n' "$dir"
            return 0
        fi
        dir="$(dirname "$dir")"
    done

    printf '.\n'
}

edition_for_manifest_dir() {
    local manifest_dir="$1"
    local edition

    edition="$(sed -n 's/^edition = "\(.*\)"/\1/p' "$manifest_dir/Cargo.toml" | head -n 1)"
    if [[ -z "$edition" ]]; then
        edition="2021"
    fi

    printf '%s\n' "$edition"
}

for file in "${staged_rust_files[@]}"; do
    if ! git diff --quiet -- "$file"; then
        echo "pre-commit: refusing to auto-format $file because it has unstaged changes." >&2
        echo "Stage or stash all edits in that file, then commit again." >&2
        exit 1
    fi
done

for file in "${staged_rust_files[@]}"; do
    manifest_dir="$(find_manifest_dir "$file")"
    edition="$(edition_for_manifest_dir "$manifest_dir")"
    rustfmt --edition "$edition" --config skip_children=true "$file"
done

git add -- "${staged_rust_files[@]}"
