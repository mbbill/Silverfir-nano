  "harness_source": "use sf_nano_core::Module;\nuse std::{hint::black_box, time::{Duration, Instant}};\nfn main() {\n    let args: Vec<String> = std::env::args().collect();\n    let wasm = std::fs::read(&args[1]).unwrap();\n    // Establish semantic validity before any unsafe diagnostic parse. The\n    // exact same immutable bytes are reused; this is not a benchmark shortcut.\n    drop(Module::new(\"verified\", &wasm).unwrap());\n    if args.get(2).map(String::as_str) == Some(\"profile\") {\n        let start = Instant::now(); let mut count = 0;\n        while start.elapsed() < Duration::from_secs(12) {\n            drop(black_box(Module::new(\"profile\", black_box(&wasm)).unwrap()));\n            count += 1;\n        }\n        println!(\"profiled {count} validated module constructions\");\n        return;\n    }\n    let iterations = (2_000_000 / wasm.len()).clamp(1, 100);\n    for pair in 0..9 {\n        for checked in if pair % 2 == 0 { [false, true] } else { [true, false] } {\n            let start = Instant::now();\n            for _ in 0..iterations {\n                let module = if checked { Module::new(\"checked\", black_box(&wasm)) } else {\n                    // SAFETY: Module::new accepted these exact bytes above;\n                    // no mutation is possible while this immutable slice lives.\n                    unsafe { Module::new_unchecked(\"parse\", black_box(&wasm)) }\n                }.unwrap();\n                drop(black_box(module));\n            }\n            println!(\"{pair},{checked},{}\", start.elapsed().as_nanos() as f64 / iterations as f64);\n        }\n    }\n}\n",
